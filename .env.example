# Server Configuration
NODE_ENV="development" # development | test | production
APP_ENV="local"        # local | staging | production
APP_URL=http://localhost:3000
PORT=3000

# Database Configuration (Supabase PostgreSQL)
# Transaction Pooler — gunakan untuk DATABASE_URL (runtime)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection — gunakan untuk DIRECT_URL (prisma migrate)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET=replace_with_at_least_32_characters_secret
JWT_EXPIRE=1h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Email / SMTP Configuration (e.g. Gmail App Password or Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=
EMAIL_LOGO_URL="https://lh3.googleusercontent.com/d/1OXwQyeaZm5IA3xApxh2DJcVmJ8XfcFzT"
EMAIL_HEADER_BANNER_URL="https://lh3.googleusercontent.com/d/1edkvpTlvJHNLjjYl-VZEZRDnu9B3TnYv"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
